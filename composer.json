{
    "name": "laravel/laravel",
    "type": "project",
    "description": "ECW",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^2.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "darkaonline/l5-swagger": "^10.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "guzzlehttp/psr7": "^2.8",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^2.7",
        "laravel/framework": "^12.61.1",
        "laravel/passport": "^13.0",
        "laravel/socialite": "^5.1",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^4.0",
        "phpseclib/phpseclib": "^3.0.33",
        "pragmarx/google2fa-laravel": "^3.0",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-analytics": "^5.5",
        "tightenco/ziggy": "^2.0",
        "unisharp/laravel-filemanager": "~2.10.1",
        "wildside/userstamps": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.9.1",
        "laracasts/cypress": "^3.0.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
