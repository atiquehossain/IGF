APP_NAME=IGF
APP_ENV=local
APP_KEY=
APP_DEBUG=false
DEBUGBAR_ENABLED=false
APP_LOCALIZATION=false
APP_URL=http://localhost:8000
SEO_INDEXING_ENABLED=false
# Production CORS defaults to APP_URL. Add comma-separated browser origins only
# when a separately hosted, reviewed frontend requires them.
CORS_ALLOWED_ORIGINS=

# SEO redirects are same-origin by default. If external redirects are a
# documented requirement, enable them and list exact HTTPS destination hosts.
SEO_REDIRECT_ALLOW_EXTERNAL=false
SEO_REDIRECT_ALLOWED_HOSTS=
# L5_SWAGGER_CONST_HOST = http://localhost:8000/api
# ASSET_URL=APP_URL=http://localhost:8000/public

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_RETENTION_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_SECURE_COOKIE defaults to true when APP_ENV=production.
MEMBER_SOCIAL_AUTO_APPROVE=false
TRUSTED_PROXIES=
# SECURITY_HSTS_ENABLED defaults to true when APP_ENV=production.
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false

# Leave every value blank until the client approves a written retention
# schedule. Blank/invalid values disable that policy, and the command is a
# preview unless privacy:apply-retention is invoked with --execute.
PRIVACY_CONTACT_ENQUIRY_DAYS=
PRIVACY_SPONSORSHIP_ENQUIRY_DAYS=
PRIVACY_VOLUNTEER_APPLICATION_DAYS=
PRIVACY_CLOSED_CHAT_DAYS=
PRIVACY_SUBSCRIBER_DAYS=
PRIVACY_RETENTION_AUTOMATION_ENABLED=false
TECHNICAL_SEO_SCHEDULE_ENABLED=false
TECHNICAL_SEO_MAX_URLS=150
TECHNICAL_SEO_IN_APP_ALERTS_ENABLED=true
TECHNICAL_SEO_EMAIL_ALERTS_ENABLED=false
# Comma-separated recipients; ignored unless email alerts are enabled.
TECHNICAL_SEO_ALERT_EMAILS=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

L5_SWAGGER_ENABLED=false
L5_SWAGGER_GENERATE_ALWAYS=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CLIENT_REDIRECT=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_REDIRECT=

API_KEY=
SEARCH_ENDPOINT=

ANALYTICS_VIEW_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# First-party SEO reporting is opt-in and read-only. The service account must
# be granted Viewer access to both approved Google properties.
SEO_PERFORMANCE_ENABLED=false
GOOGLE_SEARCH_CONSOLE_SITE_URL=
SEO_PERFORMANCE_CACHE_MINUTES=360

SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BKASH_ENABLED=true
SSLCOMMERZ_CARD_ENABLED=true
# Keep Nagad disabled until SSLCommerz confirms the enabled channel key for this merchant account.
SSLCOMMERZ_NAGAD_ENABLED=false
SSLCOMMERZ_NAGAD_GATEWAY_KEY=
